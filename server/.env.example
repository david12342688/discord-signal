# Copy to .env and fill in. .env is gitignored — never commit it.

# Shared secret the capture extension sends in the X-Capture-Auth header.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=

# --- Used from build step 4 (classification) onwards ---
ANTHROPIC_API_KEY=

# --- Used from build step 6 (notifications) onwards ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENROUTER_API_KEY=
