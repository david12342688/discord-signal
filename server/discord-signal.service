# Reference systemd unit — usable once sudo is available:
#   sudo cp discord-signal.service /etc/systemd/system/
#   sudo systemctl enable --now discord-signal
# Until then, cron @reboot runs start.sh instead.
[Unit]
Description=discord-signal processor (ingest + pipeline)
After=network-online.target
Wants=network-online.target

[Service]
User=david
WorkingDirectory=/home/david/discord-signal/server
ExecStart=/home/david/discord-signal/server/.venv/bin/uvicorn ingest:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
